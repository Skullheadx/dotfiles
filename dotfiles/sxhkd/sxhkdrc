super + space
    @dmenu@/bin/dmenu_run

super + Return
    @st@/bin/st

super + b
    @surf@/bin/surf

super + shift + b
    @librewolf@/bin/librewolf

XF86AudioRaiseVolume
    @pamixer@/bin/pamixer -i 5

XF86AudioLowerVolume
    @pamixer@/bin/pamixer -d 5

XF86AudioMute
    @pamixer@/bin/pamixer -t

XF86AudioPlay 
    @mpc@/bin/mpc toggle

XF86AudioStop 
    @mpc@/bin/mpc stop

XF86AudioNext 
    @mpc@/bin/mpc next 

XF86AudioPrev 
    @mpc@/bin/mpc prev 

super + s
    @maim@/bin/maim -i $(@xdotool@/bin/xdotool getactivewindow) | @xclip@/bin/xclip -selection clipboard -t image/png

super + shift + s
    @maim@/bin/maim -s | @xclip@/bin/xclip -selection clipboard -t image/png

super + l
    @lockscreen@/bin/lock-screen

super + f
    @st@/bin/st -e @sfeed@/bin/sfeed_curses /mnt/data/sfeed/feeds/*

super + m
    @st@/bin/st -e @rmpc@/bin/rmpc
 

